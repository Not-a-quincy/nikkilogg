                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="63">Iyashikei</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="64">Love Polygon</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="74">Love Status Quo</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="65">Magical Sex Shift</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="66">Mahou Shoujo</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="17">Martial Arts</label>
