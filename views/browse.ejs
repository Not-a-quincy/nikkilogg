    <link rel="alternate icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="stylesheet" href="/css/tokens.css">
    <link rel="stylesheet" href="/css/browse.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1&display=block" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&family=Noto+Sans+JP:wght@400;500;700&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
    <title>Browse Anime</title>
    <%- include('partials/meta', { metaTitle: "Browse anime — Nikkilog", metaDescription: "Filter thousands of series by genre, season, year and rating.", }) %>
    <script>window.isLoggedIn = "<%= isLoggedIn ? 'true' : 'false' %>";</script>
</head>
<body class="main-body">

    <%- include('partials/announcement') %>

    <%- include('partials/topbar', { active: 'browse' }) %>

    <!-- Search Overlay -->
    <div class="search-overlay-container" id="searchOverlay">
        <div class="search">
            <input type="search" placeholder="Search anime..." data-search id="searchInput" aria-label="Search anime">
        </div>
        <div class="search-results" id="searchResults">
            <!-- Dynamic search results go here -->
        </div>
    </div>

    <!-- Filter Overlay (for mobile/small screens) -->
    <div class="filter-overlay">
        <div class="filter-panel">
            <header class="filter-head">
                <h2 class="filter-title">Filter Anime</h2>
                <button class="close-filter" type="button" aria-label="Close filters"><i class="material-symbols-outlined">close</i></button>
            </header>
            <div class="filter-body">
                <p class="filter-hint">
                    <span class="material-symbols-outlined">info</span>
                    Tap a tag once to require it, twice to exclude it.
                </p>

            <div class="filter-section">
                <p>Genres</p>
                <div class="tag-grid genres-group">
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="1">Action</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="2">Adventure</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="5">Avant Garde</label>
