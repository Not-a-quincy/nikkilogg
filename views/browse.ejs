                </div>
           </div>
            </div>
            <div class="apply_clear_btn">
                <button class="clear-filters"><i class="material-symbols-outlined">delete</i><span class="btn-label">Clear All</span></button>
                <button class="apply-filters"><i class="material-symbols-outlined">check</i><span class="btn-label">Apply</span></button>
           </div>
        </div>
    </div>

    <!-- Main Content Area: Contains Sort/Filter and Anime Grid -->
    <main class="content-area">
        <!-- Sort and Filter Controls Container -->
        <div id="anime-sort">

            <select id="type-sort">
                <option value="">All Types</option>
                <option value="tv">TV</option>
                <option value="movie">Movie</option>
                <option value="ova">OVA</option>
                <option value="ona">ONA</option>
                <option value="special">Special</option>
            </select>

            <select id="status-sort">
                <option value="">All Status</option>
                <option value="Currently Airing">Airing</option>
                <option value="Finished Airing">Completed</option>
                <option value="Not yet aired">Upcoming</option>
            </select>

            <select id="year-select">
                <option value="">All Year</option>
            </select>
            <select id="season-select">
                <option value="">All Seasons</option>
                <option value="winter">Winter</option>
                <option value="spring">Spring</option>
                <option value="summer">Summer</option>
                <option value="fall">Fall</option>
            </select>

            <select id="sortBy">
                <option value="popularity">Popularity</option>
                <option value="average_rating">Rating</option>
                <option value="members">Members</option>
                <option value="favorites">Favorites</option>
            </select>

            <button class="filter-btn"><i class="material-symbols-outlined">tune</i>Filter<span class="filter-count" id="filterCount" hidden></span></button>

        </div>


         <div id="no-anime-message"></div>
         
        <!-- Dynamic Anime Grid Container -->
        <div id="dynamic_anime_grid">

