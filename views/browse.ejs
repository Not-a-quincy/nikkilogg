                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="40">Psychological</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="3">Racing</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="72">Reincarnation</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="73">Reverse Harem</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="21">Samurai</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="23">School</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="75">Showbiz</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="29">Space</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="11">Strategy game</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="31">Super Power</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="76">Survival</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="77">Team Sports</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="78">Time Travel</label>
