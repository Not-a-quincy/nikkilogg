                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="4">Comedy</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="8">Drama</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="10">Fantasy</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="26">Girls Love</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="47">Gourmet</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="14">Horror</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="7">Mystery</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="22">Romance</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="24">Sci-Fi</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="36">Slice of Life</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="30">Sports</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="37">Supernatural</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="41">Suspense</label>
                </div>
            </div>

            <div class="filter-section">
                <p>Themes</p>
                <div class="tag-grid themes-group">
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="50">Adult Cast</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="51">Anthropomorphic</label>
                    <label><input class="tag-checkbox" data-state="0" type="checkbox" value="52">CGDCT</label>
