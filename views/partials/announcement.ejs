<!-- Announcement bar: filled in by /js/promos.js when there is an active announcement -->
<div class="announce-bar" id="announceBar" hidden>
    <div class="announce-inner">
        <span class="material-symbols-outlined">campaign</span>
        <p class="announce-text" id="announceText"></p>
        <a class="announce-link" id="announceLink" href="#" hidden>Details</a>
        <button class="announce-close" id="announceClose" type="button" aria-label="Dismiss announcement">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
</div>
